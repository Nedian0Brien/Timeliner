<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac Catalyst 전용. iOS는 빈 Timeliner.entitlements를 그대로 쓴다.
	     맥에서는 샌드박스가 켜져 있어야 배포가 가능하고, 켜는 순간 iOS에서는
	     그냥 되던 것들(캘린더·미리알림·네트워크)을 하나씩 열어줘야 한다. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Unsplash 배경을 받아오고, 일정에 붙은 링크를 여는 데 쓴다. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- EventKitSyncManager가 캘린더와 미리알림을 양방향으로 동기화한다. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.reminders</key>
	<true/>
	<!-- PhotosPicker는 별도 프로세스에서 고른 파일만 넘겨주므로 읽기만 있으면 된다. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
